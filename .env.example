# Replace both placeholders with independent random secrets of at least 32 characters.
CONSENTGUARD_API_KEY=replace-me
CONSENTGUARD_USER_REF_HMAC_KEY=replace-me
CONSENTGUARD_APP_ID=local-demo

# Prototype defaults: restriction after 3 blocked attempts in 7 days; 60 checks/minute.
CONSENTGUARD_BLOCKED_ATTEMPT_THRESHOLD=3
CONSENTGUARD_RESTRICTION_WINDOW_SECONDS=604800
CONSENTGUARD_RATE_LIMIT_REQUESTS=60
CONSENTGUARD_RATE_LIMIT_WINDOW_SECONDS=60
CONSENTGUARD_RISK_BLOCK_THRESHOLD=0.85
CONSENTGUARD_ENABLE_TEST_SIGNALS=false

# Store the private Ed25519 key outside the repository, readable only by the service.
CONSENTGUARD_SIGNING_KEY_PATH=C:\secure\consentguard-ed25519-private.pem
CONSENTGUARD_CONSENT_ISSUER=consentguard.local
CONSENTGUARD_CONSENT_TOKEN_TTL_SECONDS=900
CONSENTGUARD_CONSENT_DATABASE_PATH=C:\secure\consentguard.sqlite3

# Simulated bearer-code subject actions are for local demos only; never production.
CONSENTGUARD_ENABLE_DEMO_SUBJECT_ACTIONS=false
