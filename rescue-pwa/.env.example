# ConsentGuard Rescue Kit — Environment Variables
# Copy to .env and adjust.

# Leave empty to use mock mode for ledger lookup.
# Set to the running gateway base URL for live integration.
# Example: VITE_GATEWAY_BASE_URL=http://127.0.0.1:8000
VITE_GATEWAY_BASE_URL=

# App version shown in manifest.json
VITE_APP_VERSION=0.1.0-prototype
