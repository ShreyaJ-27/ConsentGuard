# ConsentGuard PhotoMagic Demo — Environment Variables
# Copy to .env and adjust.

# Set to running gateway base URL. Leave empty to force mock mode.
# Example: VITE_GATEWAY_BASE_URL=http://127.0.0.1:8000
VITE_GATEWAY_BASE_URL=

# Prototype-only demo API key exposed in browser.
# WARNING: For production, use a backend proxy — never expose a production key here.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
VITE_GATEWAY_API_KEY=

# Set to "true" to force mock mode regardless of VITE_GATEWAY_BASE_URL.
VITE_MOCK_MODE=true
